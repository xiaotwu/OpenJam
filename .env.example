# Copy to .env and set unique credentials before deploying.
# Generate secrets with openssl rand -hex 32.
SHIORI_PUBLISH_HOST=127.0.0.1
SHIORI_PUBLISH_PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

POSTGRES_USER=openjam
POSTGRES_PASSWORD=replace-with-a-random-database-secret
POSTGRES_DB=openjam

MINIO_ACCESS_KEY=openjam
MINIO_SECRET_KEY=replace-with-a-random-storage-secret
MINIO_BUCKET=openjam
