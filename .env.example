# For a fresh installation, copy to .env and set unique credentials.
# Generate secrets with openssl rand -hex 32.
# Upgrades must keep the original Compose project, database, bucket, and credentials.
# COMPOSE_PROJECT_NAME=shiori
SHIORI_PUBLISH_HOST=127.0.0.1
SHIORI_PUBLISH_PORT=8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

POSTGRES_USER=shiori
POSTGRES_PASSWORD=replace-with-a-random-database-secret
POSTGRES_DB=shiori

MINIO_ACCESS_KEY=shiori
MINIO_SECRET_KEY=replace-with-a-random-storage-secret
MINIO_BUCKET=shiori
