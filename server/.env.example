# ===========================================
# OpenJam Server Configuration
# ===========================================
# Copy this file to .env and adjust values
# cp .env.example .env

# Server
PORT=8080
ENVIRONMENT=development          # development | production
# OPENJAM_BIND_HOST=127.0.0.1
# Set false when running openjam-server migrate separately.
OPENJAM_AUTO_MIGRATE=true
# OPENJAM_TRUSTED_PROXIES=127.0.0.1

# PostgreSQL (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openjam?sslmode=disable

# Redis (optional - enables caching and multi-server sync)
REDIS_URL=redis://localhost:6379

# CORS - comma-separated list of allowed origins
# In development: your frontend dev server
# In production: your actual domain(s)
CORS_ORIGINS=http://localhost:5173

# S3-compatible storage for private images.
MINIO_ENDPOINT=localhost:8333
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
# Bucket name must match across all services; default is "openjam"
MINIO_BUCKET=openjam

# Optional board assistant. Enable the AI Compose profile and configure a model.
# OPENJAM_AGENT_URL=http://agent:8091
# OPENJAM_AGENT_TOKEN=
# OPENJAM_OPENAI_MODEL=
# OPENAI_API_KEY=
# OPENJAM_OLLAMA_MODEL=
# OPENJAM_OLLAMA_URL=http://host.docker.internal:11434
# OPENJAM_EXTERNAL_AGENT_MODEL=
# OPENJAM_EXTERNAL_AGENT_LABEL=
# OPENJAM_EXTERNAL_AGENT_URL=
# OPENJAM_EXTERNAL_AGENT_TOKEN=
# OPENJAM_AGENT_PROMPT_PACK=
# OPENJAM_AGENT_MOCK=false

# Session Security
# NOTE: Sessions are stored in PostgreSQL as random tokens; no signing secret
# is required. The SESSION_SECRET variable is ignored.
# SESSION_SECRET=
