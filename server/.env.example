# ===========================================
# Shiori Server Configuration
# ===========================================
# Copy this file to .env and adjust values
# cp .env.example .env

# Server
PORT=8080
ENVIRONMENT=development          # development | production
# SHIORI_BIND_HOST=127.0.0.1
# Set false when running shiori-server migrate separately.
SHIORI_AUTO_MIGRATE=true
# SHIORI_TRUSTED_PROXIES=127.0.0.1

# PostgreSQL (required)
# Match the user, password, and database in the root Compose .env.
DATABASE_URL=postgres://shiori:replace-with-a-random-database-secret@localhost:5432/shiori?sslmode=disable

# Redis (optional - enables caching and multi-server sync)
REDIS_URL=redis://localhost:6379

# CORS - comma-separated list of allowed origins
# In development: your frontend dev server
# In production: your actual domain(s)
CORS_ORIGINS=http://localhost:5173

# S3-compatible storage for private images.
MINIO_ENDPOINT=localhost:8333
# Match the object storage credentials and bucket in the root Compose .env.
MINIO_ACCESS_KEY=shiori
MINIO_SECRET_KEY=replace-with-a-random-storage-secret
MINIO_USE_SSL=false
MINIO_BUCKET=shiori

# Optional board assistant. Enable the AI Compose profile and configure a model.
# SHIORI_AGENT_URL=http://agent:8091
# SHIORI_AGENT_TOKEN=
# SHIORI_OPENAI_MODEL=
# OPENAI_API_KEY=
# SHIORI_OLLAMA_MODEL=
# SHIORI_OLLAMA_URL=http://host.docker.internal:11434
# SHIORI_EXTERNAL_AGENT_MODEL=
# SHIORI_EXTERNAL_AGENT_LABEL=
# SHIORI_EXTERNAL_AGENT_URL=
# SHIORI_EXTERNAL_AGENT_TOKEN=
# SHIORI_AGENT_PROMPT_PACK=
# SHIORI_AGENT_MOCK=false

# Session Security
# NOTE: Sessions are stored in PostgreSQL as random tokens; no signing secret
# is required. The SESSION_SECRET variable is ignored.
# SESSION_SECRET=
