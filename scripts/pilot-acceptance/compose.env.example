# Copy to a protected environment file and fill it before starting Compose.
# Record the approved image ID in the acceptance record.
SHIORI_IMAGE=ghcr.io/xiaotwu/shiori@sha256:replace-with-approved-digest
SHIORI_PUBLISH_HOST=127.0.0.1
SHIORI_PUBLISH_PORT=8080
ENVIRONMENT=production
CORS_ORIGINS=https://pilot.example.test

# Fill only with the immediate proxy IP or narrow CIDR seen by the API,
# when the pilot uses forwarded client addresses for its rate limits.
SHIORI_TRUSTED_PROXIES=

# Use a fresh hex secret, or provide a percent-encoded DATABASE_URL if needed.
POSTGRES_USER=shiori
POSTGRES_PASSWORD=replace-with-a-random-database-secret
POSTGRES_DB=shiori
REDIS_URL=redis://redis:6379

# The default offsite backup flow uses the Compose SeaweedFS bucket.
MINIO_ENDPOINT=seaweedfs:8333
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=shiori
MINIO_SECRET_KEY=replace-with-a-random-storage-secret
MINIO_BUCKET=shiori
