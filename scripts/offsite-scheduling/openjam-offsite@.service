[Unit]
Description=OpenJam offsite %i schedule
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=openjam-ops
WorkingDirectory=/opt/openjam
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/openjam/scripts/openjam-ops.py --project openjam --env-file /etc/openjam/compose.env offsite tick --config /etc/openjam/offsite-%i.json --role %i
KillMode=mixed
TimeoutStartSec=30min
TimeoutStopSec=3min
